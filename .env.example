# Copy to .env (which git ignores) and fill in. Never commit real keys.

# Gemini API key from Google AI Studio.
GOOGLE_API_KEY=

# A Marg-shaped database for the agents to read, relative to the project root.
# Create one with: uv run batchward demo-marg sim-out/marg.sqlite
BATCHWARD_MARG_DB=sim-out/marg.sqlite

# Batchward's own records: recall notices, holds placed on batches, and ceiling prices.
# Create one alongside the demo with:
#   uv run batchward demo-marg sim-out/marg.sqlite --records sim-out/records.sqlite
BATCHWARD_RECORDS=sim-out/records.sqlite

# Optional: the model every agent uses.
# BATCHWARD_MODEL=gemini-2.5-flash

# Optional: analyse as of this date instead of the day after the last movement.
# BATCHWARD_TODAY=2026-03-01

# Optional: comma-separated locations stock is never sold from.
# BATCHWARD_UNSELLABLE_LOCATIONS=RETURNS

# Optional: approvals on WhatsApp through Meta's Cloud API (`batchward whatsapp`).
# From the app's WhatsApp > API setup page in Meta for Developers. Never commit them.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# The app secret, which signs every webhook delivery, from App settings > Basic.
# WHATSAPP_APP_SECRET=
# Any string you choose; enter the same one when you register the webhook with Meta.
# WHATSAPP_VERIFY_TOKEN=
# An approved utility template with two quick-reply buttons (Approve, Reject) and a
# body with two variables, the request number and its summary. Needed to reach an
# approver who has not written to the business number in the last 24 hours.
# WHATSAPP_APPROVAL_TEMPLATE=
# The template's language code exactly as in WhatsApp Manager, e.g. en or en_US.
# WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional: the Graph API version; defaults to v25.0.
# WHATSAPP_API_VERSION=v25.0
# Who may approve: a CSV of phone,name with the country code on every number.
# BATCHWARD_APPROVERS=approvers.csv
